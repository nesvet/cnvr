{
	"compilerOptions": {
		"target": "ESNext",
		"lib": [ "ESNext" ],
		"moduleDetection": "force",
		"module": "ESNext",
		"rootDir": "src",
		"moduleResolution": "bundler",
		"types": [ "node" ],
		"allowJs": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": [ "src/**/*" ]
}
